{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/admin-campaigns",
      "destination": "/api/admin?action=campaigns"
    },
    {
      "source": "/api/admin-coupons",
      "destination": "/api/admin?action=coupons"
    },
    {
      "source": "/api/admin-customers",
      "destination": "/api/admin?action=customers"
    },
    {
      "source": "/api/admin-orders",
      "destination": "/api/admin?action=orders"
    },
    {
      "source": "/api/admin-refund",
      "destination": "/api/admin?action=refund"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}

{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://bt-templates.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://bt-templates.onrender.com/uploads/:match*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
